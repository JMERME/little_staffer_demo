# Apache: Flutter-Web SPA unter einem UNTERORDNER (z. B. /little_staffer_demo/)
#
# Wenn du hier landest, weil im Browser „Unexpected token '<'“ in flutter_bootstrap.js
# oder manifest.json auftritt: Der Server hat sehr wahrscheinlich index.html für diese
# URLs ausgeliefert (HTML beginnt mit „<“). Typische Ursachen:
# - RewriteRule zeigt auf /index.html (Domain-Root) statt auf den Ordner der App
# - RewriteBase passt nicht zum Unterordner
# - Eine .htaccess im übergeordneten Verzeichnis leitet alles auf eine andere index.html
#
# Deployment: Diese Datei liegt in build/web/ und muss mit hochgeladen werden in genau
# den Ordner, der deiner App-URL entspricht (z. B. …/little_staffer_demo/.htaccess).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # MUSS zum Flutter --base-href passen (mit führendem und trailing Slash).
  # Beispiel App-URL: https://app.tecto-app.com/little_staffer_demo/
  RewriteBase /little_staffer_demo/

  # Nur wenn die Datei physisch NICHT existiert → SPA-Fallback.
  # Wichtig: So werden flutter_bootstrap.js, manifest.json, main.dart.js, assets/ …
  # weiterhin als echte Dateien ausgeliefert.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Relativ zu RewriteBase — NICHT /index.html verwenden (das wäre der Domain-Root)!
  RewriteRule ^ index.html [L]
</IfModule>

# Optional: Force HTTPS (falls nicht schon zentral bei IONOS)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType application/wasm .wasm
  AddType font/woff2 .woff2
</IfModule>

# Einstiegspunkte ohne Content-Hash: nach Deploy immer neu laden (mod_headers).
# Siehe docs/DEPLOY_WEB.md — Cache-Matrix für Web-Deploys.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "^(flutter_bootstrap\.js|flutter_service_worker\.js|manifest\.json|version\.json|main\.dart\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
